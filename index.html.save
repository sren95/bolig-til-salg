<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bolig til salg</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <main>
    <section class="hero">
      <p class="eyebrow">Privat salg</p>
      <h1>Bolig til salg</h1>
      <p class="subtitle">Kort, ærlig og overskuelig salgspræsentation.</p>
      <a class="button" href="mailto:soren.petersen95@gmail.com">Kontakt sælger</a>
    </section>

    <section class="facts">
      <div><strong>Pris</strong><span>Kommer snart</span></div>
      <div><strong>Boligareal</strong><span>Kommer snart</span></div>
      <div><strong>Værelser</strong><span>Kommer snart</span></div>
      <div><strong>Adresse</strong><span>Kommer snart</span></div>
    </section>
  </main>
</body>
</html>


nano style.css



body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f6f3ee;
  color: #1f1f1f;
}

main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 48px 20px;
}

.hero {
  background: white;
  border-radius: 28px;
  padding: 64px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.08);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 13px;
  color: #7a6a56;
}

h1 {
  font-size: clamp(44px, 8vw, 88px);
  line-height: 0.95;
  margin: 16px 0;
}

.subtitle {
  font-size: 22px;
  max-width: 620px;
  color: #555;
}

.button {
  display: inline-block;
  margin-top: 28px;
  padding: 14px 22px;
  border-radius: 999px;
  background: #1f1f1f;
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.facts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 24px;
}

.facts div {
  background: white;
  border-radius: 20px;
  padding: 22px;
}

.facts strong,
.facts span {
  display: block;
}

.facts span {
  margin-top: 8px;
  color: #666;
}

@media (max-width: 800px) {
  .hero {
    padding: 36px 24px;
  }

  .facts {
    grid-template-columns: 1fr 1fr;
  }
}



